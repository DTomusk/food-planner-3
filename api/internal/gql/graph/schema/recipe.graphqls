type Recipe {
  id: ID!
  author: User! @goField(forceResolver: true)
  createdAt: Time!

  currentVersion: RecipeVersion! @goField(forceResolver: true)
  versions: [RecipeVersion!]! @goField(forceResolver: true)

  draftVersion: RecipeVersion @goField(forceResolver: true) @auth

  version(version: Int!): RecipeVersion
}

type RecipeVersion {
  id: ID!
  recipe: Recipe! @goField(forceResolver: true)

  version: Int!
  name: String!
  description: String!
  ingredientUsages: [IngredientUsage!]! @goField(forceResolver: true)
  prepMins: Int!
  cookMins: Int!
  portions: Int!
  imgSrc: String
  animalProductLevel: Int!
  containsGluten: Boolean!
  source: RecipeSource! @goField(forceResolver: true)

  createdAt: Time!
}

type IngredientUsage {
  id: ID!
  ingredient: Ingredient!
  unit: Unit!
  quantity: Float!
}

type Unit {
  val: Int!
  name: String!
  symbol: String!
}

type RecipeSource {
  type: Int!
  url: String
  bookTitle: String
  bookPage: Int
  instructions: String
}

extend type Query {
  recipes(
    pagination: PaginationInput
    filter: RecipeFilterInput
  ): RecipeConnection!
  recipe(id: ID!): Recipe
}

type RecipeConnection {
  edges: [RecipeEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type RecipeEdge {
  node: Recipe!
  cursor: String!
}

input RecipeFilterInput {
  query: String
  userID: ID
  animalProductLevel: Int
  containsGluten: Boolean
}

input CreateRecipeInput {
  name: String!
  description: String
  ingredientUsages: [CreateIngredientUsageInput!]!
  prepMins: Int!
  cookMins: Int!
  portions: Int!
  recipeSource: CreateRecipeSourceInput!
  imgUploadId: ID
  publish: Boolean!
}

input CreateIngredientUsageInput {
  ingredientID: ID!
  unit: Int!
  quantity: Float!
}

input CreateRecipeSourceInput {
  type: Int!
  url: String
  bookTitle: String
  bookPage: Int
  instructions: String
}

input UpdateRecipeInput {
  id: ID!
  details: CreateRecipeInput!
  removeImage: Boolean
}

extend type Mutation {
  createRecipe(input: CreateRecipeInput!): Recipe! @auth
  updateRecipe(input: UpdateRecipeInput!): Recipe! @auth
}

