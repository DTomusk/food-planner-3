type Recipe {
  id: ID!
  name: String!
  ingredientUsages: [IngredientUsage!]! @goField(forceResolver: true)
  user: User! @goField(forceResolver: true)
  prepMins: Int!
  cookMins: Int!
  portions: Int!
}

type IngredientUsage {
  id: ID!
  ingredient: Ingredient!
  unit: Unit!
  quantity: Float!
}

type Unit {
  val: Int!
  name: String!
  symbol: String!
}

extend type Query {
  recipes: [Recipe!]!
  recipe(id: ID!): Recipe
}

input CreateRecipeInput {
  name: String!
  ingredientUsages: [CreateIngredientUsageInput!]!
  prepMins: Int!
  cookMins: Int!
  portions: Int!
}

input CreateIngredientUsageInput {
  ingredientID: ID!
  unit: Int!
  quantity: Float!
}

extend type Mutation {
  createRecipe(input: CreateRecipeInput!): Recipe! @auth
}
