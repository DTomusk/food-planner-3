type Recipe {
  id: ID!
  author: User! @goField(forceResolver: true)
  createdAt: Time!

  currentVersion: RecipeVersion! @goField(forceResolver: true)
  versions: [RecipeVersion!]! @goField(forceResolver: true)
}

type RecipeVersion {
  id: ID!
  recipe: Recipe! @goField(forceResolver: true)

  version: Int!
  name: String!
  ingredientUsages: [IngredientUsage!]! @goField(forceResolver: true)
  prepMins: Int!
  cookMins: Int!
  portions: Int!
  source: RecipeSource! @goField(forceResolver: true)

  createdAt: Time!
}

type IngredientUsage {
  id: ID!
  ingredient: Ingredient!
  unit: Unit!
  quantity: Float!
}

type Unit {
  val: Int!
  name: String!
  symbol: String!
}

type RecipeSource {
  type: Int!
  url: String
  bookTitle: String
  bookPage: Int
  instructions: String
}

enum RecipeStatus {
  ACTIVE
  DELETED
}

input RecipeFilter {
  status: RecipeStatus
}

extend type Query {
  recipes: [Recipe!]!
  recipe(id: ID!): Recipe
}

input CreateRecipeInput {
  name: String!
  ingredientUsages: [CreateIngredientUsageInput!]!
  prepMins: Int!
  cookMins: Int!
  portions: Int!
  recipeSource: CreateRecipeSourceInput!
}

input CreateIngredientUsageInput {
  ingredientID: ID!
  unit: Int!
  quantity: Float!
}

input CreateRecipeSourceInput {
  type: Int!
  url: String
  bookTitle: String
  bookPage: Int
  instructions: String
}

input DeleteRecipeInput {
  id: ID!
}

input UndeleteRecipeInput {
  id: ID!
}

extend type Mutation {
  createRecipe(input: CreateRecipeInput!): Recipe! @auth
}

