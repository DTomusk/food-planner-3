extend type Mutation {
    signup(input: SignUpInput!): AuthPayload!
    signin(input: SignInInput!): AuthPayload!
    refresh: AuthPayload!
}

input SignUpInput {
    email: String!
    password: String!
    username: String!
}

input SignInInput {
    email: String!
    password: String!
}

type AuthPayload {
    jwt: String!
    user: User!
}