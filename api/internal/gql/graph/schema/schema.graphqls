directive @auth on FIELD_DEFINITION

scalar Time

schema {
  query: Query
  mutation: Mutation
}

type Query {
  _empty: String
}

type Mutation {
  _empty: String
}

directive @goField(
  forceResolver: Boolean
  name: String
  omittable: Boolean
) on FIELD_DEFINITION

input PaginationInput {
  first: Int
  after: String
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

enum SortDirection {
  ASC
  DESC
}